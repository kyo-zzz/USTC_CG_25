                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/Ch03_Body_001/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }
        }
    }
}

